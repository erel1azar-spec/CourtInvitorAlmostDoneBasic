<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CourtInvitor.Views.NavigationPageAdmin"
             xmlns:m="clr-namespace:CourtInvitor.Models"
             xmlns:vm="clr-namespace:CourtInvitor.ViewModels"
             x:DataType="vm:NavigationPageAdminVM">
    <Grid>
        <Image
            Aspect="AspectFill"
            Source="background.jpeg" />
        <Button
            Text="{StaticResource IconArrow_left_alt}"
            Style="{StaticResource BackButtonStyle}"
            TextColor="White"
            Command="{Binding NavBackHomeCommand}" />
        <Border
            BackgroundColor="#CC1A1A2E"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            Padding="30"
            Margin="20"
            VerticalOptions="Center"
            HorizontalOptions="Center">
            <VerticalStackLayout
                Spacing="15"
                HorizontalOptions="Center">
                <Button
                    Text="{x:Static m:Strings.AdminCreateCourt}"
                    Command="{Binding NavToCreateCourtCommand}"
                    Style="{StaticResource NavigationButtonStyle}" />
                <Button
                    Text="{x:Static m:Strings.AdminReservationsMade}"
                    Command="{Binding NavToReservationsMadeCommand}"
                    Style="{StaticResource NavigationButtonStyle}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>