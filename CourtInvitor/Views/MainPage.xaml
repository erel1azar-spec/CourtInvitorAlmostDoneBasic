<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CourtInvitor.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:CourtInvitor.Models"
    xmlns:vm="clr-namespace:CourtInvitor.ViewModels"
    x:DataType="vm:MainPageVM">
    <Grid>
        <Image
            Source="background.jpeg"
            Aspect="AspectFill" />
        <Border
            BackgroundColor="#CC1A1A2E"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            Padding="30"
            Margin="20"
            VerticalOptions="Center"
            HorizontalOptions="Center">
            <VerticalStackLayout
                Spacing="20"
                HorizontalOptions="Center">
                <Label
                    Text="{Binding WelcomeUserName}"
                    TextColor="White"
                    FontSize="28"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />
                <Button
                    IsVisible="{Binding LoginVisibility}"
                    Text="{x:Static m:Strings.LoginOrRegisterButton}"
                    Style="{StaticResource NavigationButtonStyle}"
                    Command="{Binding NavToLoginCommand}" />
                <Button
                    IsVisible="{Binding SignOutVisibility}"
                    Text="{x:Static m:Strings.SignOutButton}"
                    Style="{StaticResource NavigationButtonStyle}"
                    Command="{Binding SignOutCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
