<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CourtInvitor.Views.MakeReservationClientPage"
             xmlns:m="clr-namespace:CourtInvitor.Models"
             xmlns:vm="clr-namespace:CourtInvitor.ViewModels"
             x:DataType="vm:MakeReservationClientPageVM">
    <Grid>
        <Image
            Aspect="AspectFill"
            Source="background.jpeg" />
        <Button
            Text="{StaticResource IconArrow_left_alt}"
            Style="{StaticResource BackButtonStyle}"
            TextColor="White"
            Command="{Binding NavBackHomeCommand}" />
        <Border
            BackgroundColor="#CC1A1A2E"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            Padding="30"
            Margin="20"
            VerticalOptions="Center"
            HorizontalOptions="Center">
            <Label
                Text="{x:Static m:Strings.MakeReservationText}"
                TextColor="White"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>