<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CourtInvitor.ViewModels"
             xmlns:m="clr-namespace:CourtInvitor.Models"
             x:Class="CourtInvitor.Views.RegisterPage"
             x:DataType="vm:RegisterPageVM">
    <Grid>
        <Image
            Aspect="AspectFill"
            Source="background.jpeg" />
        <ScrollView>
            <Border
                BackgroundColor="#CC1A1A2E"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="25"
                Margin="20"
                VerticalOptions="Center"
                HorizontalOptions="Fill">
                <VerticalStackLayout
                    Spacing="12"
                    FlowDirection="LeftToRight">
                    <Label
                        Text="{x:Static m:Strings.RegisterTitle}"
                        TextColor="White"
                        FontSize="28"
                        FontAttributes="Bold"
                        HorizontalOptions="Start" />
                    <Border
                        Padding="12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#E8FFFFFF">
                        <Entry
                            Placeholder="{x:Static m:Strings.UserName}"
                            Text="{Binding UserName}"
                            TextColor="#1A1A2E"
                            PlaceholderColor="#666666"
                            HorizontalTextAlignment="Start"
                            HorizontalOptions="Fill"
                            FlowDirection="LeftToRight" />
                    </Border>
                    <Border
                        Padding="12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#E8FFFFFF">
                        <Entry
                            Placeholder="{x:Static m:Strings.Email}"
                            Text="{Binding Email}"
                            TextColor="#1A1A2E"
                            PlaceholderColor="#666666"
                            HorizontalTextAlignment="Start"
                            HorizontalOptions="Fill"
                            FlowDirection="LeftToRight" />
                    </Border>
                    <Border
                        Padding="12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#E8FFFFFF">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                Placeholder="{x:Static m:Strings.Password}"
                                Text="{Binding Password}"
                                IsPassword="{Binding IsPassword}"
                                TextColor="#1A1A2E"
                                PlaceholderColor="#666666"
                                HorizontalTextAlignment="Start"
                                HorizontalOptions="Fill"
                                FlowDirection="LeftToRight" />
                            <Button
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                FontFamily="MaterialSymbols"
                                FontSize="22"
                                TextColor="#1A1A2E"
                                Command="{Binding ToggleIsPasswordCommand}"
                                Text="{Binding IsPassword, Converter={StaticResource passwordIconConvert}}" />
                        </Grid>
                    </Border>
                    <Border
                        Padding="12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#E8FFFFFF">
                        <Picker
                            ItemsSource="{Binding Roles}"
                            SelectedItem="{Binding SelectedRole}"
                            TextColor="#1A1A2E"
                            Title="{x:Static m:Strings.SelectRoleTitle}"
                            TitleColor="#666666"
                            HorizontalOptions="Fill"
                            FlowDirection="LeftToRight" />
                    </Border>
                    <Button
                        Text="{x:Static m:Strings.SubmitRegisterButtonText}"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource NavigationButtonStyle}" />
                    <Label
                        HorizontalOptions="Center"
                        Margin="0,5,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span
                                    Text="{x:Static m:Strings.OwnAccountText}"
                                    TextColor="White" />
                                <Span
                                    Text="{x:Static m:Strings.Login}"
                                    TextColor="#60A5FA"
                                    TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding NavToLoginCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>