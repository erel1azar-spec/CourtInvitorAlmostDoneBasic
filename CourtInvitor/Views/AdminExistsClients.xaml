<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CourtInvitor.Views.AdminExistsClients"
             xmlns:m="clr-namespace:CourtInvitor.Models"
             xmlns:vm="clr-namespace:CourtInvitor.ViewModels"
             x:DataType="vm:AdminExistsClientsVM">
    <Grid FlowDirection="LeftToRight">
        <Image
            Aspect="AspectFill"
            Source="background.jpeg" />
        <Button
            Text="{StaticResource IconArrow_left_alt}"
            Style="{StaticResource BackButtonStyle}"
            TextColor="White"
            HorizontalOptions="Start"
            Command="{Binding NavBackHomeCommand}" />
        <ScrollView Margin="20,60,20,20">
            <Border
                BackgroundColor="#CC1A1A2E"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="15"
                HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Fill" FlowDirection="LeftToRight">
                    <Label
                        Text="{Binding PageTitle}"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalOptions="Start"
                        HorizontalTextAlignment="Start"
                        Margin="0,0,0,10" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Hours}" Spacing="4" HorizontalOptions="Fill">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:AdminHourSlotModel">
                                <Border
                                    BackgroundColor="#4A5568"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="15,12"
                                    HorizontalOptions="Fill">
                                    <HorizontalStackLayout Spacing="10" FlowDirection="LeftToRight">
                                        <Label
                                            Text="{Binding TimeText}"
                                            TextColor="White"
                                            FontSize="14"
                                            VerticalOptions="Center" />
                                        <Label
                                            Text="-"
                                            TextColor="White"
                                            FontSize="14"
                                            VerticalOptions="Center" />
                                        <Label
                                            Text="{Binding StatusText}"
                                            TextColor="{Binding StatusTextColor}"
                                            FontSize="14"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
