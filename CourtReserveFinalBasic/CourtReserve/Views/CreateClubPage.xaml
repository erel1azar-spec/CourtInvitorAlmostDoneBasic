<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CourtReserve.Views.CreateClubPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:CourtReserve.Models"
    xmlns:vm="clr-namespace:CourtReserve.ViewModels"
    x:DataType="vm:CreateClubPageVM">
    <Grid>
        <Image Aspect="AspectFill" Source="background.jpeg" />
        <Button
            Command="{Binding NavBackHomeCommand}"
            Style="{StaticResource BackButtonStyle}"
            Text="{StaticResource IconArrow_left_alt}"
            TextColor="White"
            ZIndex="10" />
        <ScrollView>
            <Border
                Margin="20"
                Padding="25"
                BackgroundColor="#CC1A1A2E"
                HorizontalOptions="Fill"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                VerticalOptions="Center">
                <VerticalStackLayout FlowDirection="LeftToRight" Spacing="8">
                    <Label
                        FontSize="14"
                        HorizontalOptions="Start"
                        Text="{x:Static m:Strings.ClubNameLabel}"
                        TextColor="White" />
                    <Border
                        Padding="12"
                        BackgroundColor="#E8FFFFFF"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Entry
                            FlowDirection="LeftToRight"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="Start"
                            PlaceholderColor="#666666"
                            Text="{Binding ClubName}"
                            TextColor="#1A1A2E" />
                    </Border>
                    <Label
                        FontSize="14"
                        HorizontalOptions="Start"
                        Text="{x:Static m:Strings.LocationLabel}"
                        TextColor="White" />
                    <Border
                        Padding="12"
                        BackgroundColor="#E8FFFFFF"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Entry
                            FlowDirection="LeftToRight"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="Start"
                            PlaceholderColor="#666666"
                            Text="{Binding Location}"
                            TextColor="#1A1A2E" />
                    </Border>
                    <Label
                        FontSize="14"
                        HorizontalOptions="Start"
                        Text="{x:Static m:Strings.PhoneLabel}"
                        TextColor="White" />
                    <Border
                        Padding="12"
                        BackgroundColor="#E8FFFFFF"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Entry
                            FlowDirection="LeftToRight"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="Start"
                            PlaceholderColor="#666666"
                            Text="{Binding Phone}"
                            TextColor="#1A1A2E" />
                    </Border>
                    <Label
                        FontSize="14"
                        HorizontalOptions="Start"
                        Text="{x:Static m:Strings.EmailLabel}"
                        TextColor="White" />
                    <Border
                        Padding="12"
                        BackgroundColor="#E8FFFFFF"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Entry
                            FlowDirection="LeftToRight"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="Start"
                            PlaceholderColor="#666666"
                            Text="{Binding Email}"
                            TextColor="#1A1A2E" />
                    </Border>
                    <Label
                        FontSize="14"
                        HorizontalOptions="Start"
                        Text="{x:Static m:Strings.CourtsCountLabel}"
                        TextColor="White" />
                    <Border
                        Padding="12"
                        BackgroundColor="#E8FFFFFF"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Picker
                            ItemsSource="{Binding CourtsNumbers}"
                            SelectedItem="{Binding CourtsCount}"
                            TextColor="#1A1A2E" />
                    </Border>
                    <Button
                        Margin="0,15,0,0"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Text="{x:Static m:Strings.SaveClubButton}" />
                    <Label
                        Margin="0,5,0,0"
                        FontAttributes="Bold"
                        FontSize="14"
                        HorizontalOptions="Center"
                        Text="{Binding StatusMessage}"
                        TextColor="{Binding StatusColor}" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>