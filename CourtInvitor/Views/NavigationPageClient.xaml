<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CourtInvitor.Views.NavigationPageClient"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:CourtInvitor.Models"
    xmlns:vm="clr-namespace:CourtInvitor.ViewModels"
    x:DataType="vm:NavigationPageClientVM">
    <Grid>
        <Image
            Aspect="AspectFill"
            Source="background.jpeg" />
        <Button
            Text="{StaticResource IconArrow_left_alt}"
            Style="{StaticResource BackButtonStyle}"
            TextColor="White"
            Command="{Binding NavBackHomeCommand}" />
        <Border
            BackgroundColor="#CC1A1A2E"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            Padding="30"
            Margin="20"
            VerticalOptions="Center"
            HorizontalOptions="Center">
            <VerticalStackLayout
                Spacing="15"
                HorizontalOptions="Center">
                <Button
                    Text="{x:Static m:Strings.MakeReservationText}"
                    Command="{Binding NavToMakeReservationCommand}"
                    Style="{StaticResource NavigationButtonStyle}" />
                <Button
                    Text="{x:Static m:Strings.MyReservationsText}"
                    Command="{Binding NavToMyReservationsCommand}"
                    Style="{StaticResource NavigationButtonStyle}" />
                <Label
                    Text="{Binding TimeLeft}"
                    TextColor="White"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>