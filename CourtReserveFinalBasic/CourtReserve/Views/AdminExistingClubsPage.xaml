<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CourtReserve.Views.AdminExistingClubsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:CourtReserve.Models"
    xmlns:vm="clr-namespace:CourtReserve.ViewModels"
    x:DataType="vm:AdminExistingClubsPageVM">
    <Grid>
        <Image Aspect="AspectFill" Source="background.jpeg" />
        <Button
            Command="{Binding NavBackHomeCommand}"
            Style="{StaticResource BackButtonStyle}"
            Text="{StaticResource IconArrow_left_alt}"
            TextColor="White" />
        <Border
            Margin="20,60,20,20"
            Padding="15"
            BackgroundColor="#CC1A1A2E"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0">
            <CollectionView ItemsSource="{Binding Clubs}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:AdminExistingClubsTextModel">
                        <Grid Margin="5">
                            <Button
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminExistingClubsPageVM}}, Path=ClubSelectedCommand}"
                                CommandParameter="{Binding ClubText}"
                                Style="{StaticResource NavigationButtonStyle}"
                                WidthRequest="-1"
                                HorizontalOptions="Fill"
                                Text="{Binding ClubText}" />
                            <Border
                                Padding="8,4"
                                BackgroundColor="#2D3748"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                HorizontalOptions="End"
                                Margin="0,0,10,0">
                                <Label
                                    Text="{Binding AvailabilityText}"
                                    TextColor="#60A5FA"
                                    FontSize="13" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>

</ContentPage>