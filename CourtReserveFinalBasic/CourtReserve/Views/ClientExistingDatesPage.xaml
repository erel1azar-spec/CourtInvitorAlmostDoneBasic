<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CourtReserve.Views.ClientExistingDatesPage"
             xmlns:m="clr-namespace:CourtReserve.Models"
             xmlns:vm="clr-namespace:CourtReserve.ViewModels"
             x:DataType="vm:ClientExistingDatesPageVM">
    <Grid>
        <Image Aspect="AspectFill" Source="background.jpeg" />
        <Button
        Command="{Binding NavBackHomeCommand}"
        Style="{StaticResource BackButtonStyle}"
        Text="{StaticResource IconArrow_left_alt}"
        TextColor="White" />
        <Border
        Margin="20,60,20,20"
        Padding="15"
        BackgroundColor="#CC1A1A2E"
        StrokeShape="RoundRectangle 20"
        StrokeThickness="0">
            <CollectionView ItemsSource="{Binding Dates}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:AdminExistingDatesTextModel">
                        <Button
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClientExistingDatesPageVM}}, Path=DateSelectedCommand}"
                        CommandParameter="{Binding DateText}"
                        Style="{StaticResource DateButtonStyle}"
                        Text="{Binding DateText}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>