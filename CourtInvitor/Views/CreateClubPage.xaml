<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CourtInvitor.Views.CreateClubPage"
             xmlns:m="clr-namespace:CourtInvitor.Models"
             xmlns:vm="clr-namespace:CourtInvitor.ViewModels"
             x:DataType="vm:CreateClubPageVM">
    <Grid>
        <Image
            Aspect="AspectFill"
            Source="background.jpeg" />
        <Button
            Text="{StaticResource IconArrow_left_alt}"
            Style="{StaticResource BackButtonStyle}"
            TextColor="White"
            Command="{Binding NavBackHomeCommand}" />
        <ScrollView>
            <Border
                BackgroundColor="#CC1A1A2E"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="25"
                Margin="20"
                VerticalOptions="Center"
                HorizontalOptions="Fill">
                <VerticalStackLayout
                    Spacing="8"
                    FlowDirection="LeftToRight">
                    <Label
                        Text="{x:Static m:Strings.ClubNameLabel}"
                        TextColor="White"
                        FontSize="14"
                        HorizontalOptions="Start" />
                    <Border
                        Padding="12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#E8FFFFFF">
                        <Entry
                            Text="{Binding ClubName}"
                            TextColor="#1A1A2E"
                            PlaceholderColor="#666666"
                            HorizontalTextAlignment="Start"
                            HorizontalOptions="Fill"
                            FlowDirection="LeftToRight" />
                    </Border>
                    <Label
                        Text="{x:Static m:Strings.LocationLabel}"
                        TextColor="White"
                        FontSize="14"
                        HorizontalOptions="Start" />
                    <Border
                        Padding="12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#E8FFFFFF">
                        <Entry
                            Text="{Binding Location}"
                            TextColor="#1A1A2E"
                            PlaceholderColor="#666666"
                            HorizontalTextAlignment="Start"
                            HorizontalOptions="Fill"
                            FlowDirection="LeftToRight" />
                    </Border>
                    <Label
                        Text="{x:Static m:Strings.PhoneLabel}"
                        TextColor="White"
                        FontSize="14"
                        HorizontalOptions="Start" />
                    <Border
                        Padding="12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#E8FFFFFF">
                        <Entry
                            Text="{Binding Phone}"
                            TextColor="#1A1A2E"
                            PlaceholderColor="#666666"
                            HorizontalTextAlignment="Start"
                            HorizontalOptions="Fill"
                            FlowDirection="LeftToRight" />
                    </Border>
                    <Label
                        Text="{x:Static m:Strings.EmailLabel}"
                        TextColor="White"
                        FontSize="14"
                        HorizontalOptions="Start" />
                    <Border
                        Padding="12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#E8FFFFFF">
                        <Entry
                            Text="{Binding Email}"
                            TextColor="#1A1A2E"
                            PlaceholderColor="#666666"
                            HorizontalTextAlignment="Start"
                            HorizontalOptions="Fill"
                            FlowDirection="LeftToRight" />
                    </Border>
                    <Label
                        Text="{x:Static m:Strings.CourtsCountLabel}"
                        TextColor="White"
                        FontSize="14"
                        HorizontalOptions="Start" />
                    <Border
                        Padding="12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#E8FFFFFF">
                        <Picker
                            ItemsSource="{Binding CourtsNumbers}"
                            SelectedItem="{Binding CourtsCount}"
                            TextColor="#1A1A2E" />
                    </Border>
                    <Button
                        Text="{x:Static m:Strings.SaveClubButton}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Margin="0,15,0,0" />
                    <Label
                        Text="{Binding StatusMessage}"
                        TextColor="{Binding StatusColor}"
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>