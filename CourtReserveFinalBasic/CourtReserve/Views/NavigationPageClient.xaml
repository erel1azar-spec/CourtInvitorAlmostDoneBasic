<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CourtReserve.Views.NavigationPageClient"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:CourtReserve.Models"
    xmlns:vm="clr-namespace:CourtReserve.ViewModels"
    x:DataType="vm:NavigationPageClientVM">
    <Grid>
        <Image Aspect="AspectFill" Source="background.jpeg" />
        <Button
            Command="{Binding NavBackHomeCommand}"
            Style="{StaticResource BackButtonStyle}"
            Text="{StaticResource IconArrow_left_alt}"
            TextColor="White" />
        <Border
            Margin="20"
            Padding="30"
            BackgroundColor="#CC1A1A2E"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0"
            VerticalOptions="Center">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="15">
                <Button
                    Command="{Binding NavToMakeReservationCommand}"
                    Style="{StaticResource NavigationButtonStyle}"
                    Text="{x:Static m:Strings.MakeReservationText}" />
                <Button
                    Command="{Binding NavToMyReservationsCommand}"
                    Style="{StaticResource NavigationButtonStyle}"
                    Text="{x:Static m:Strings.MyReservationsText}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>