<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CourtInvitor.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:CourtInvitor.Models"
    xmlns:vm="clr-namespace:CourtInvitor.ViewModels"
    x:DataType="vm:LoginPageVM">
    <Grid>
        <Image
            Aspect="AspectFill"
            Source="background.jpeg" />
        <Button
            Text="{StaticResource IconArrow_left_alt}"
            Style="{StaticResource BackButtonStyle}"
            TextColor="White"
            Command="{Binding NavBackHomeCommand}" />
        <ScrollView>
            <Border
                BackgroundColor="#CC1A1A2E"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="25"
                Margin="20"
                VerticalOptions="Center"
                HorizontalOptions="Fill">
                <VerticalStackLayout
                    Spacing="15"
                    FlowDirection="LeftToRight">
                    <Label
                        Text="{x:Static m:Strings.LoginTitle}"
                        TextColor="White"
                        FontSize="28"
                        FontAttributes="Bold"
                        HorizontalOptions="Start" />
                    <Border
                        Padding="12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#E8FFFFFF">
                        <Entry
                            Placeholder="{x:Static m:Strings.Email}"
                            Text="{Binding Email}"
                            TextColor="#1A1A2E"
                            PlaceholderColor="#666666"
                            HorizontalTextAlignment="Start"
                            HorizontalOptions="Fill"
                            FlowDirection="LeftToRight" />
                    </Border>
                    <Border
                        Padding="12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="#E8FFFFFF">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                IsPassword="{Binding IsPassword}"
                                Placeholder="{x:Static m:Strings.Password}"
                                Text="{Binding Password}"
                                TextColor="#1A1A2E"
                                PlaceholderColor="#666666"
                                HorizontalTextAlignment="Start"
                                HorizontalOptions="Fill"
                                FlowDirection="LeftToRight" />
                            <Button
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                Command="{Binding ToggleIsPasswordCommand}"
                                FontFamily="MaterialSymbols"
                                FontSize="22"
                                Text="{Binding IsPassword, Converter={StaticResource passwordIconConvert}}"
                                TextColor="#1A1A2E" />
                        </Grid>
                    </Border>
                    <Button
                        Text="{x:Static m:Strings.SubmitLoginButtonText}"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource NavigationButtonStyle}" />
                    <Label
                        HorizontalOptions="Center"
                        Margin="0,5,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static m:Strings.DontOwnAccountText}" TextColor="White" />
                                <Span
                                    Text="{x:Static m:Strings.Register}"
                                    TextColor="#60A5FA"
                                    TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NavToRegisterCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>