<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CourtReserve.Views.NavigationPageAdmin"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:CourtReserve.Models"
    xmlns:vm="clr-namespace:CourtReserve.ViewModels"
    x:DataType="vm:NavigationPageAdminVM">
    <Grid>
        <Image Aspect="AspectFill" Source="background.jpeg" />
        <Button
            Margin="10"
            Command="{Binding SignOutCommend}"
            HorizontalOptions="Start"
            Text="{x:Static m:Strings.SignOut}"
            TextColor="White"
            VerticalOptions="Start" />
        <Border
            Margin="20"
            Padding="30"
            BackgroundColor="#CC1A1A2E"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0"
            VerticalOptions="Center">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="15">
                <Button
                    Command="{Binding NavToCreateCourtCommand}"
                    Style="{StaticResource NavigationButtonStyle}"
                    Text="{x:Static m:Strings.AdminCreateCourt}" />
                <Button
                    Command="{Binding NavToReservationsMadeCommand}"
                    Style="{StaticResource NavigationButtonStyle}"
                    Text="{x:Static m:Strings.AdminReservationsMade}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>